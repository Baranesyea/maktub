{
  "name": "Snapshot",
  "properties": {
    "book_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "content_more": {
      "description": "The rest of a long text: the server limits each text field to about 20,000 characters",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reason": {
      "type": "string"
    },
    "scene_id": {
      "type": "string"
    },
    "word_count": {
      "type": "number"
    }
  },
  "required": [
    "scene_id"
  ],
  "rls": {
    "create": true,
    "delete": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    }
  },
  "type": "object"
}