{
  "name": "Era",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "start": {
      "type": "string"
    },
    "end": {
      "type": "string"
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "book_id",
    "name"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}