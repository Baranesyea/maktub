{
  "name": "Idea",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "done": {
      "type": "boolean",
      "default": false
    },
    "scene_id": {
      "type": "string"
    },
    "link_chapter_id": {
      "type": "string"
    },
    "link_scene_id": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}