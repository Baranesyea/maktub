{
  "name": "Inspiration",
  "properties": {
    "board": {
      "description": "Place on the inspiration board: x, y, w (and h for notes)",
      "type": "object"
    },
    "book_id": {
      "type": "string"
    },
    "character_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "content": {
      "description": "Notes about the image, rich text",
      "type": "string"
    },
    "content_more": {
      "description": "The rest of a long text: the server limits each text field to about 20,000 characters",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "deleted": {
      "default": false,
      "type": "boolean"
    },
    "file_uri": {
      "description": "Private file (full size)",
      "type": "string"
    },
    "height": {
      "type": "number"
    },
    "kind": {
      "default": "image",
      "description": "image: a picture with its own page; note: a sticky note on the board; text: free text written straight on the board",
      "enum": [
        "image",
        "note",
        "text"
      ],
      "type": "string"
    },
    "link_chapter_id": {
      "type": "string"
    },
    "link_scene_id": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "thumb_uri": {
      "description": "Private file (small, for the gallery)",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "width": {
      "type": "number"
    }
  },
  "required": [
    "book_id"
  ],
  "type": "object",
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}