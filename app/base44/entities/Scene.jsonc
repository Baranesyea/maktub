{
  "name": "Scene",
  "properties": {
    "book_id": {
      "type": "string"
    },
    "chapter_id": {
      "type": "string"
    },
    "character_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "content": {
      "type": "string"
    },
    "content_more": {
      "description": "The rest of a long text: the server limits each text field to about 20,000 characters",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "deleted": {
      "default": false,
      "type": "boolean"
    },
    "deleted_at": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "status": {
      "default": "idea",
      "enum": [
        "idea",
        "draft",
        "editing",
        "done"
      ],
      "type": "string"
    },
    "story_time": {
      "type": "object"
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "unused": {
      "default": false,
      "type": "boolean"
    },
    "word_count": {
      "type": "number"
    }
  },
  "required": [
    "book_id",
    "chapter_id"
  ],
  "rls": {
    "create": true,
    "delete": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    }
  },
  "type": "object"
}