{
  "name": "Part",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "book_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}